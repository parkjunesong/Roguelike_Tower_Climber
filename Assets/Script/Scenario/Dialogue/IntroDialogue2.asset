  lines:
  - speaker: "\uB124\uBE0C"
    text: "\uADF8\uB798\uC11C \uB4F1\uBC18\uC790\uB2D8\uC740 \uD0D1\uC5D0 \uC65C
      \uB4E4\uC5B4\uC624\uC2DC\uAC8C \uB41C\uAC70\uC5D0\uC694?"
    background:
      action: 1
      sprite: {fileID: -8001407560079858681, guid: 3fcb73d83a0f2884a91558a2d071a96f, type: 3}
    left:
      action: 2
      sprite: {fileID: 0}
    front:
