    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB124\uBE0C"
    text: "(\uD0D1 \uC5B4\uCA4C\uAD6C \uC800\uCA4C\uAD6C)  "
    left:
      action: 1
