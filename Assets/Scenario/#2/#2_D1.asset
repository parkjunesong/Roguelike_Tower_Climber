  lines:
  - speaker: "\uB124\uBE0C"
    text: "\uADF8\uB798\uC11C \uB4F1\uBC18\uC790\uB2D8\uC740 \uD0D1\uC5D0 \uC65C
      \uB4E4\uC5B4\uC624\uC2DC\uAC8C \uB41C\uAC70\uC5D0\uC694?"
    left:
      action: 2
      sprite: {fileID: 0}
    front:
      action: 1
      sprite: {fileID: -9197134654715703934, guid: d847aaed0e9154e42b79285f456e1242, type: 3}
    right:
      action: 2
      sprite: {fileID: 0}
    background:
      action: 1
      sprite: {fileID: -2300132173592728999, guid: e872be78340703b4cb3bcc3150ba3728, type: 3}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB4F1\uBC18\uC790"
    text: " \uC800.. \uC0AC\uC2E4, \uD0D1\uC774 \uBB54\uC9C0 \uC804\uD600 \uBAA8\uB974\uACA0\uC5B4. "
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB4F1\uBC18\uC790"
    text: "\uB0B4\uAC00 \uAE30\uC5B5\uD558\uB294\uAC74.. \uB09C \uB9C8\uC744\uC5D0\uC11C
      \uB3D9\uC0DD\uACFC \uD568\uAED8 \uB180\uB2E4\uAC00 \uC815\uCCB4\uBD88\uBA85\uC758
      \uBE5B\uC744 \uB300\uC2E0 \uB9DE\uACE0 \uC815\uC2E0\uC744 \uC783\uC5C8\uACE0,
      \uAE68\uC5B4\uB098\uB2C8\uAE4C \uC9C0\uAE08 \uC5EC\uAE30\uB77C\uB294\uAC70\uC57C."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB4F1\uBC18\uC790"
    text: "\uB0B4\uAC00 \uC0B4\uB358 \uB9C8\uC744\uC740 \uC774\uB7F0 \uB3D9\uAD74\uAC19\uC740
      \uACF3\uC774 \uC544\uB2C8\uC600\uC5B4. \uD574\uB3C4 \uB728\uACE0, \uD558\uB298\uB3C4
      \uBCF4\uC774\uB294.. \uADF8\uB7F0 \uACF3\uC774\uC600\uC5B4. \uC5EC\uAE30\uB294
      \uC5B4\uB518\uB370?"
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB124\uBE0C"
    text: "\uD0D1\uC744 \uBAA8\uB974\uC2E0\uB2E4\uAD6C\uC694?!\n"
    left:
      action: 1
      sprite: {fileID: 0}
    front:
      action: 1
      sprite: {fileID: -3033126602819275161, guid: e91552c4f14c43d489e3e73fc6b32936, type: 3}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: -2685238702643228683, guid: 59a036e3f08d6b0408f535388a1e7e69, type: 3}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB124\uBE0C"
    text: "\uC73C\uC74C.. \uADF8\uB7FC \uD0D1\uC5D0 \uB300\uD574\uC11C \uC124\uBA85\uD574\uB4DC\uB9B4\uAC8C\uC694! "
    left:
      action: 1
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB124\uBE0C"
    text: "(\uB300\uBD84\uC5F4 \uC5B4\uCA4C\uAD6C \uC800\uCA4C\uAD6C) "
    left:
      action: 1
      sprite: {fileID: 0}
