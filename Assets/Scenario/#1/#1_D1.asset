    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB124\uBE0C"
    text: "\uC800\uB294 \uB124\uBE0C\uB77C\uACE0 \uD574\uC694! \n\uAD11\uC7A5\uC5D0\uC11C\uB294
      \uBABB \uBCF4\uB358 \uC5BC\uAD74\uC778\uB370, \uC0C8\uB85C \uD0D1\uC744 \uC624\uB974\uB7EC
      \uB4E4\uC5B4\uC624\uC2E0 \uB4F1\uBC18\uC790\uB2D8\uC774\uC2DC\uC8E0? "
