  - speaker: "\uAE30\uC5B5 \uC18D\uC758 \uB098"
    text: "\uB124\uC544!! \uB3C4\uB9DD\uCCD0!!!"
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 3
    nextLineDelay: 1
  - speaker: 
    text: "\uAC15\uB82C\uD55C \uBE5B\uC774 \uB098\uB97C \uB36E\uCCE4\uB2E4.\n\uC815\uC2E0\uC774
      \uD76C\uBBF8\uD574\uC9C4\uB2E4."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
