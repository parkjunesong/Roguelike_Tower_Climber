      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: ???
    text: "\uC800\uAE30\uC694\uC624~?\n\uBABB \uBCF4\uB358 \uC5BC\uAD74\uC778\uB370..
      \uC0C8\uB85C \uB4E4\uC5B4\uC624\uC2E0\uAC74\uAC00? "
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: ???
    text: "\uC815\uC2E0 \uC880 \uCC28\uB824 \uBD10\uC694!"
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 2
    nextLineDelay: 0
  - speaker: 
    text: "\uC624\uB7AB\uB3D9\uC548 \uAC10\uACA8\uC788\uB358 \uB208\uC744 \uB72C\uB2E4.\n\uB9C8\uC9C0\uB9C9
      \uAE30\uC5B5\uACFC\uB294 \uB2E4\uB978 \uC7A5\uC18C\uB2E4, \uAD70\uB370\uAD70\uB370
      \uBE5B\uB098\uB294 \uD478\uB978 \uAD11\uBB3C\uC774 \uBC15\uD600\uC788\uB294
      \uB3D9\uAD74\uC774\uB2E4."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 1
      sprite: {fileID: 8452935545671602921, guid: 2f41ca5303d286b478ed1a14ba54112b, type: 3}
    bgm:
      action: 1
      clip: {fileID: 8300000, guid: aaf1ab238cb958f4a95caeb82146078b, type: 3}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: 
    text: "\uC65C \uB545\uC18D \uAD6C\uB369\uC774\uC5D0 \uB0B4\uAC00 \uB4E4\uC5B4\uAC00
      \uC788\uB294\uAC74\uC9C0..."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: 
    text: "\uC5EC\uAE30\uB294 \uC5B4\uB514\uC57C..? \uB108\uB294.. \uB204\uAD6C\uACE0?\n\uB098\uB97C
      \uB545\uC18D\uC5D0 \uBB3B\uC740 \uBC94\uC778\uC774 \uB108\uC57C..?"
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: ???
    text: "\uB124\uC5D0?? \uADF8\uB7F4\uB9AC\uAC00\uC694!\n\uC21C\uCC30 \uCF54\uC2A4\uC911\uC5D0
      \uC815\uC2E0\uC744 \uC783\uACE0 \uC4F0\uB7EC\uC838\uACC4\uC2DC\uAE38\uB798
      \uB9D0\uC744 \uAC74 \uAC83 \uBFD0\uC774\uC5D0\uC694! "
    left:
      action: 0
      sprite: {fileID: 5918068991513046458, guid: e2dd371d7de24b24e8b86fe9b301ec66, type: 3}
    front:
      action: 0
