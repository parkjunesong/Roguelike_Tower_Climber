    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: "\uB8E8\uC5D4"
    text: "\uC544, \uB0B4 \uC774\uB984\uC740 \uB8E8\uC5D4\uC774\uC57C. \uD0D1.. \uB4F1\uBC18\uC790..?
