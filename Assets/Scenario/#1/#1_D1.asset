      action: 1
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: 
    text: "\uADF8\uB807\uAC8C, \uC2DC\uAC04\uC774 \uC5BC\uB9C8\uB098 \uD758\uB800\uC744\uAE4C."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: 
    text: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uD76C\uBBF8\uD55C \uC0AC\uB78C\uC758
      \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC628\uB2E4."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
    background:
      action: 0
      sprite: {fileID: 0}
    bgm:
      action: 0
      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: ???
    text: "... \uAD1C\uCC2E\uC73C\uC138\uC694?.."
    left:
      action: 0
      sprite: {fileID: 0}
    front:
      action: 0
      sprite: {fileID: 0}
    right:
      action: 0
      sprite: {fileID: 0}
