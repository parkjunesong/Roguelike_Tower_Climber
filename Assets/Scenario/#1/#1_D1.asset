      clip: {fileID: 0}
    blackoutDuration: 0
    nextLineDelay: 0
  - speaker: 
    text: "\uADF8\uB54C, \uC606\uC5D0\uC11C \uC870\uADF8\uB9C8\uD55C \uCD08\uB85D\uC0C9
      \uC2AC\uB77C\uC784 2\uB9C8\uB9AC\uAC00 \uB098\uD0C0\uB09C\uB2E4."
